{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "/home/cyzhu/.config/fastfetch/logo/03.png",
    	"type": "kitty",
      	"height": 22,
      	"padding": {
    		"top": 1
      	}
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 16
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
        },
        {
            "type": "separator",
            "string": "-",   // 分隔线字符
            "times": 0       // 自动填充到终端宽度
        },
        {
            "type": "os",
            "key": "OS   ",
            "keyColor": "31",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  kernel",
            "keyColor": "31",
        },
        {
            "type": "packages",
            "combined": true,
            "key": " ├ 󰏖 packages",
            "keyColor": "31",
        },
        {
            "type": "shell",
            "key": " └  shell",
            "keyColor": "31",
        },
        //"break",
        {
            "type": "de",
            "key": "DE   ",
            "keyColor": "32",
        },
        {
            "type": "wm",
            "key": " ├  wm",
            "keyColor": "32", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 wmtheme",
            "keyColor": "32",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 icons",
            "keyColor": "32",
        },
        {
            "type": "terminal",
            "key": " ├  terminal",
            "keyColor": "32",
        },
        {
            "type": "terminalfont",
            "key": " └  font",
            "keyColor": "32", 
        },
        //"break",
        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": "PC   ",
            "keyColor": "33",
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ├  cpu",
            "keyColor": "33",
        },
        {
            "type": "gpu",
            "key": " ├ 󰢮 gpu",
            "keyColor": "33",
        },
        {
            "type": "memory",
            "key": " ├  memory",
            "keyColor": "33",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 swap",
            "keyColor": "33",
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 disk",
            "keyColor": "33",
        },
        {
            "type": "monitor",
            "format": "{1} {2}x{3} px @ {11} Hz - {4}x{5} mm",
            "key": " ├  display",
            "keyColor": "33",
        },
        {
            "type": "battery",
            "key": " ├  battery",
            "keyColor": "33"
        },
        {
            "type": "localip",
            "key": " └ 󰩟 local-ip",
            "keyColor": "33"
        },     
        "break"
    ]
}
